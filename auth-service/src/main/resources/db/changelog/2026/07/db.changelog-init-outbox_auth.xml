<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        logicalFilePath="db/changelog/2026/07/db/changelog-init-outbox_auth.xml"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="init-outbox_auth" author="Sam Ulyanoff">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="outbox_auth"/>
            </not>
        </preConditions>

        <createTable tableName="outbox_auth">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="aggregate_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="sent" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="outbox_auth" indexName="idx_outbox_auth_sent_createdAt">
            <column name="sent"/>
            <column name="created_at"/>
        </createIndex>

        <rollback>
            <dropTable tableName="outbox_auth"/>
        </rollback>

    </changeSet>
</databaseChangeLog>