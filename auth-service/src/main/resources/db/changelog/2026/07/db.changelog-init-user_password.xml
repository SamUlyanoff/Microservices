<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        logicalFilePath="db/changelog/2026/07/db/changelog-init-user_password.xml"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="init-user_password" author="Sam Ulyanoff" failOnError="false" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="user"/>
            <not>
                <tableExists tableName="user_password"/>
            </not>
        </preConditions>

        <createTable tableName="user_password">
            <column name="user_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="password" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            constraintName="fk_user_password_user"
            baseTableName="user_password"
            baseColumnNames="user_id"
            referencedTableName="user"
            referencedColumnNames="id"
            onDelete="CASCADE"
            onUpdate="CASCADE"/>

        <rollback>
            <dropTable tableName="user_password"/>
        </rollback>

    </changeSet>
</databaseChangeLog>