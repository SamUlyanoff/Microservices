{
    "type": "record",
    "name": "UserCreatedEvent",
    "namespace": "ru.microservices.auth_service.avro",
    "fields": [
        {"name": "userId", "type": "string"},
        {"name": "firstName", "type": "string"},
        {"name": "lastName", "type": "string"},
        {"name": "email", "type": "string"},
        {"name": "password", "type": "string"},  // ← запятая добавлена!
        {"name": "createdAt", "type": {"type": "long", "logicalType": "timestamp-millis"}}  // ← кавычки у type исправлены!
    ]
}